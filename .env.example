# Copie para .env (nunca versione o .env). Todas as variáveis são opcionais.

# URL pública definitiva do site (sem barra final). Usada em canonical, sitemap e Open Graph.
SITE_URL=https://nexushospitalar.example

# production = bloqueia o build se houver produtos demonstrativos ou dados provisórios.
SITE_MODE=homologacao

# Identificadores de mensuração (deixe vazio até o proprietário criar as contas e autorizar).
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_GSC_VERIFICATION=
