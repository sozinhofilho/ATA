---
// Logotipo provisório em HTML + SVG (usa a fonte do site). Arquivos SVG/PNG equivalentes em public/images/marca/.
import { marca } from '../lib/site';
interface Props { negative?: boolean; class?: string }
const { negative = false, class: cls = '' } = Astro.props;
---
<span class:list={['logo', { 'logo--neg': negative }, cls]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <rect width="48" height="48" rx="11" fill="#087E8B" />
    <path d="M15 34 L15 14 L33 34 L33 14" fill="none" stroke="#fff" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="15" cy="14" r="4.2" fill="#fff" /><circle cx="33" cy="34" r="4.2" fill="#fff" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">{marca.nomeCaixaAlta}</span>
    <span class="logo__sub">{marca.complemento}</span>
  </span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--c-navy); line-height: 1; }
  .logo__mark { width: 40px; height: 40px; flex: none; }
  .logo__text { display: grid; gap: 4px; }
  .logo__name { font-weight: 800; font-size: 1.25rem; letter-spacing: .01em; white-space: nowrap; }
  .logo__sub { font-weight: 600; font-size: .6rem; letter-spacing: .1em; text-transform: uppercase; color: var(--c-gray-500); white-space: nowrap; }
  .logo--neg { color: #fff; }
  .logo--neg .logo__sub { color: #b9d7de; }
  @media (max-width: 380px) { .logo__mark { width: 34px; height: 34px; } .logo__name { font-size: 1.05rem; } .logo__sub { font-size: .52rem; } }
</style>
