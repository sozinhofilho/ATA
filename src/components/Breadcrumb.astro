---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
const all = [{ label: 'Início', href: '/' }, ...items];
---
<nav class="breadcrumb" aria-label="Você está em">
  <ol>
    {all.map((c, i) => (
      <li>
        {c.href && i < all.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: 4px; list-style: none; margin: 0 0 var(--sp-4); padding: 0; font-size: var(--fs-sm); color: var(--c-gray-500); }
  .breadcrumb li + li::before { content: '/'; margin-right: 4px; color: var(--c-gray-300); }
  .breadcrumb a { color: var(--c-gray-500); text-decoration: none; }
  .breadcrumb a:hover { color: var(--c-teal-dark); text-decoration: underline; }
  .breadcrumb [aria-current] { color: var(--c-navy); font-weight: 600; }
</style>
