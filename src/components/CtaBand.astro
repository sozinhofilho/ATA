---
import Icon from './Icon.astro';
import { waLink } from '../lib/whatsapp';
interface Props { title: string; text: string; message: string; buttonLabel?: string; location: string; secondary?: { href: string; label: string } }
const { title, text, message, buttonLabel = 'Falar com um especialista', location, secondary } = Astro.props;
---
<section class="cta-band" aria-labelledby={`cta-${location}`}>
  <div class="container cta-band__inner">
    <div>
      <h2 id={`cta-${location}`}>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a href={waLink(message)} class="btn btn--whatsapp" target="_blank" rel="noopener" data-track="whatsapp_click generate_lead" data-track-location={location} data-track-method="whatsapp">
        <Icon name="whatsapp" /> {buttonLabel}
      </a>
      {secondary && <a href={secondary.href} class="btn btn--ghost-light">{secondary.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band { background: linear-gradient(120deg, var(--c-navy) 0%, var(--c-navy-2) 100%); color: #d7e5ee; padding-block: var(--sp-12); }
  .cta-band__inner { display: flex; flex-wrap: wrap; gap: var(--sp-6); align-items: center; justify-content: space-between; }
  .cta-band h2 { color: #fff; margin-bottom: var(--sp-2); }
  .cta-band p { margin: 0; max-width: 60ch; }
</style>
