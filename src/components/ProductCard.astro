---
import Icon from './Icon.astro';
import { type Product, productUrl, imageOf, getCategory } from '../lib/catalog';
import { waLink, mensagens } from '../lib/whatsapp';
import { absoluteUrl } from '../lib/site';
interface Props { product: Product; headingLevel?: 'h2' | 'h3'; eager?: boolean; listName?: string; hidden?: boolean }
const { product: p, headingLevel = 'h3', eager = false, listName = 'catalogo', hidden = false } = Astro.props;
const H = headingLevel;
const img = imageOf(p.imagem_principal);
const cat = getCategory(p.categoria);
const url = productUrl(p);
---
<article class="pcard card" data-product-id={p.id} hidden={hidden}>
  <a href={url} class="pcard__media" tabindex="-1" aria-hidden="true" data-track="select_item" data-track-item-id={p.id} data-track-item-name={p.nome} data-track-item-list-name={listName}>
    <img src={img.src} alt="" width="240" height="160" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    {(img.ilustracao || p.imagem_ilustrativa) && <span class="pcard__ilustr">Imagem ilustrativa</span>}
  </a>
  <div class="pcard__body">
    <p class="pcard__cat">{cat?.nomeCurto}</p>
    <H class="pcard__title">
      <a href={url} data-track="select_item" data-track-item-id={p.id} data-track-item-name={p.nome} data-track-item-list-name={listName}>{p.nome}</a>
    </H>
    <dl class="pcard__meta">
      {p.marca && <div><dt>Marca</dt><dd>{p.marca}</dd></div>}
      {p.renem && <div><dt>RENEM</dt><dd>{p.renem}</dd></div>}
      {p.catmat && <div><dt>CATMAT</dt><dd>{p.catmat}</dd></div>}
    </dl>
    {p.descricao_resumida && <p class="pcard__desc">{p.descricao_resumida}</p>}
    <div class="pcard__badges">
      {p.ata_confirmada
        ? <span class="badge badge--ata"><Icon name="check" size={14} />Disponível para consulta em ata</span>
        : <span class="badge"><Icon name="info" size={14} />Consulte disponibilidade</span>}
      {p.demonstrativo && <span class="badge badge--demo">Demonstrativo</span>}
    </div>
    <div class="pcard__actions">
      <a href={url} class="btn btn--sm" data-track="select_item" data-track-item-id={p.id} data-track-item-name={p.nome} data-track-item-list-name={listName}>Ver detalhes<span class="sr-only"> de {p.nome}</span></a>
      <a href={waLink(mensagens.produto(p.nome, absoluteUrl(url), p.renem))} class="btn btn--outline btn--sm" target="_blank" rel="noopener"
         data-track="whatsapp_click quote_request_click" data-track-item-id={p.id} data-track-item-name={p.nome} data-track-location={`card-${listName}`}>
        Solicitar proposta<span class="sr-only"> de {p.nome} pelo WhatsApp (abre em nova aba)</span>
      </a>
    </div>
  </div>
</article>

<style>
  .pcard { display: flex; flex-direction: column; overflow: hidden; height: 100%; transition: box-shadow .15s, border-color .15s; }
  .pcard:hover { border-color: var(--c-gray-300); box-shadow: var(--shadow); }
  .pcard__media { position: relative; display: block; background: var(--c-sky); aspect-ratio: 3 / 2; }
  .pcard__media img { width: 100%; height: 100%; object-fit: contain; padding: 8px; }
  .pcard__ilustr { position: absolute; left: 8px; bottom: 6px; font-size: 11px; color: var(--c-gray-500); background: rgba(255,255,255,.85); padding: 1px 6px; border-radius: 4px; }
  .pcard__body { display: flex; flex-direction: column; gap: var(--sp-2); padding: var(--sp-4); flex: 1; }
  .pcard__cat { margin: 0; font-size: var(--fs-xs); font-weight: 650; color: var(--c-teal-dark); text-transform: uppercase; letter-spacing: .05em; }
  .pcard__title { font-size: var(--fs-base); margin: 0; }
  .pcard__title a { color: var(--c-navy); text-decoration: none; }
  .pcard__title a:hover { text-decoration: underline; }
  .pcard__meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 0; font-size: var(--fs-xs); color: var(--c-gray-500); }
  .pcard__meta div { display: block; }
  .pcard__meta dt, .pcard__meta dd { display: inline; }
  .pcard__meta dt::after { content: ' '; }
  .pcard__meta dt { font-weight: 600; }
  .pcard__meta dd { margin: 0; color: var(--c-text); font-weight: 600; }
  .pcard__desc { font-size: var(--fs-sm); color: var(--c-text); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pcard__badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: var(--sp-2); }
  .pcard__actions { display: grid; gap: var(--sp-2); }
  @media (max-width: 559px) {
    .pcard__body { padding: var(--sp-3); }
    .pcard__desc { display: none; }
    .pcard__title { font-size: var(--fs-sm); }
    .pcard .btn--sm { padding-inline: .5rem; font-size: 0.8125rem; }
  }
</style>
